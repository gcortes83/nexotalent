{
  "name": "@nexo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project http",
    "test:unit": "vitest run --project unit",
    "test:http": "vitest run --project http",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest",
    "coverage": "vitest run --project unit --project http --coverage",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/db.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/cli/db.ts seed"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.8",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.0",
    "postgres": "^4.1.1",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
