# API de NexoTalent · valores SOLO para desarrollo local (datos sintéticos).
# `make setup` copia este archivo a apps/api/.env (ignorado por git). Nunca subas el .env.

PORT=4000
HOST=0.0.0.0

# memory = sin base de datos (datos sintéticos en RAM, se reinician al reiniciar la API)
# postgres = PostgreSQL 16 + pgvector (make db-up && make migrate)
STORAGE=postgres
DATABASE_URL=postgres://nexo:nexo_local_only@localhost:5432/nexotalent

# Base de datos efímera para las pruebas de integración (make test-int)
TEST_DATABASE_URL=postgres://nexo:nexo_local_only@localhost:5433/nexotalent_test

# Mínimo 32 caracteres. En AWS vendrá de Secrets Manager.
JWT_SECRET=change-me-local-dev-secret-at-least-32-chars

# Login de demo sin contraseña (simula Cognito). Nunca true fuera de local/staging.
DEMO_AUTH=true

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AI_PROVIDER=mock

# Correos: log = simulados (ver http://localhost:4000/v1/dev/emails); smtp = Mailpit (make mail-up, UI http://localhost:8025)
EMAIL_PROVIDER=log
SMTP_URL=smtp://localhost:1025
LOG_LEVEL=info
